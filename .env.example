# SECRETS LIST - never commit real values. Set each one with:
#   cd bridge && npx wrangler secret put NAME      (or cd app for app secrets)
# Do NOT put these in wrangler.toml.

# ---- bridge secrets ----
TWILIO_ACCOUNT_SID=        # starts with AC..., Twilio Console home page
TWILIO_AUTH_TOKEN=         # Twilio Console home page (also used to verify Twilio webhooks)
XAI_API_KEY=               # console.x.ai > API Keys (used for Grok Voice calls and the voice lines)
BRIDGE_TOKEN=              # make one: openssl rand -hex 32  (same value in app AND bridge)
INGEST_TOKEN=              # make one: openssl rand -hex 32  (same value in app AND bridge)
OWNER_CELL=                # your own cell, E.164, e.g. +15555550123 (same value in app AND bridge)

# ---- app secrets ----
APP_PASSCODE=              # the passcode you type to sign in to the app
SESSION_KEY=               # make one: openssl rand -hex 32
BRIDGE_TOKEN=              # same as above
INGEST_TOKEN=              # same as above
OWNER_CELL=                # same as above
